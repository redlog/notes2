NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for the migration script (scripts/migrate.mjs)
# Find this in your Supabase project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Local SQLite mode ────────────────────────────────────────────────────────
# Set PROVIDER=sqlite to run the app locally without Supabase or authentication.
# The Supabase env vars above are not needed in this mode.
#
# PROVIDER=sqlite
#
# Optional: path to the SQLite database file (default: <cwd>/local-data/notes.db)
# SQLITE_DB_PATH=/path/to/your/OneDrive/notes/notes.db
#
# Optional: directory for image attachments (default: next to the DB file in "images/")
# LOCAL_IMAGES_DIR=/path/to/your/OneDrive/notes/images

# ── Semantic search (optional) ───────────────────────────────────────────────
# Enables meaning-based search and the "Related notes" panel, fused with the
# existing keyword search. Without a key the app runs exactly as before —
# keyword search only — and the settings toggle says so.
#
# Get a key at https://voyageai.com. The free tier (200M tokens) is far more
# than a personal notes corpus needs: ~5,000 notes is roughly 2M tokens for a
# full re-index.
#
# Also switch "Semantic search" on per project in Settings; note text is sent
# to Voyage AI to be embedded, so it is off by default.
#
# VOYAGE_API_KEY=your-voyage-key
#
# Optional. Changing either is a full re-index ("Rebuild from scratch"), and
# changing the dimension also needs a migration — note_chunks.embedding is
# declared vector(1024).
# VOYAGE_MODEL=voyage-3.5-lite
# VOYAGE_DIM=1024
#
# Required only for the scheduled drain (vercel.json cron) to authenticate.
# Without it the drain is session-only and runs from the Settings page button.
# CRON_SECRET=a-long-random-string
